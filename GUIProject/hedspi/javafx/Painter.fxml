<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/null" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUIProject.hedspi.javafx.PainterController">
    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <left>
        <VBox spacing="8" maxHeight="Infinity">
            <BorderPane.margin>
                <Insets right="8"/>
            </BorderPane.margin>

            <TitledPane text="Tools" collapsible="false">
                <content>
                    <VBox spacing="4">
                        <padding>
                            <Insets top="4" right="4" bottom="4" left="4"/>
                        </padding>

                        <fx:define>
                            <ToggleGroup fx:id="tools"/>
                        </fx:define>

                        <RadioButton text="Pen" selected="true" toggleGroup="$tools"/>
                        <RadioButton text="Eraser" toggleGroup="$tools"/>
                    </VBox>
                </content>
            </TitledPane>

            <Button
                text="Clear"
                onAction="#clearButtonPressed"
                maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <Pane
            fx:id="drawingAreaPane"
            onMouseDragged="#drawingAreaMouseDragged"
            style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;"/>
    </center>

</BorderPane>
